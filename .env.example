# Sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own origin. Sign-in links are built from it.
BETTER_AUTH_URL=http://localhost:3000

# The cohort roster, as CSV text. See roster.example.csv for the columns.
# In production this is a Fly secret, never a file in this repository.
ROSTER_CSV=

# SQLite. On Fly this is on the mounted volume.
DB_PATH=./data/app.db

# Sign-in email
RESEND_API_KEY=
RESEND_FROM=

# Ranking and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
